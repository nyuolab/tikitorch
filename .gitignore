__pycache__/
*.py[cod]
*.egg-info/
/.venv/
/.ruff_cache/
/.mypy_cache/
/.pytest_cache/
/.tox/
/.nox/
/.coverage
/htmlcov/
.ipynb_checkpoints/

# Root packaging and documentation outputs. Paper build directories are listed
# explicitly so a source directory named ``build`` deeper in the hardware tree is
# never hidden from contributors.
/build/
/dist/
/site/
/manuscript/build/
/manuscript/archive/*/build/
*.pt
/data/
.DS_Store
.vscode/

# generated model artifacts (tt.save) — mirror of the *.pt rule above
*.tt
!zoo/**/*.tt
# manuscript/results/ is a generated-output tree; track only curated, cited evidence
manuscript/results/closed_benchmarks/
manuscript/results/capacity_probe/
# Nondeterministic presentation renders; retain the editable SVG and compact PNG.
/manuscript/results/graphics/*_nb.png
# per-run console logs created by the run_* scripts
/logs/
# compiled LOCAL FPGA bridge (scripts/build_fpga_local.sh) — incl. _libtikifpga_morphlm.*
_libtikifpga*
# FPGA workflow/build/probe/csynth scratch dropped at the repo root by the run_* and
# forge tooling (state dirs + *_wf.js); regenerable, never committed. Covers the old
# .tiki_sweep_state/ too.
.tiki_*
# root-level scratch HLS kernel dirs (anchored: does NOT touch packaged
# tikitorch/hardware/.../cl_forge_* kernels or manuscript/results/*forge* logs)
/forge_*/

# FPGA build/probe fetch scratch (large regenerable DCP/tar/logs)
manuscript/results/fpga_silicon/afibuild/
manuscript/results/fpga_silicon/hdk_probe/
# AWS HDK implementation products are retained in object storage, not ordinary
# Git. Keep the small timing reports, manifests, and logs in the repository.
manuscript/results/fpga_silicon/**/to_aws/*.tar
manuscript/results/fpga_silicon/**/to_aws/*.dcp

# local API keys (manuscript/results/graphics/.env etc.)
**/.env
**/.env.*
# Deliberately reviewed, credential-free setup templates may be versioned.
!**/.env.example
!**/.env.template

# organism/experiments derived state
/data/experience_stream/
/organism_life/
.tiki_organism_state/
.tiki_g1b_state*/
/organism_report_sync/
