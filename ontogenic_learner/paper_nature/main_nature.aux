\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Error feedback cures the sign-SGD collapse.} On a held-LR, every-window-kicks, stationary, anchorless adversary, naked \texttt  {PureTropicalSGD} and a soft-bound-only variant diverge (regret climbs, weight norm runs away) while the error-feedback arms stay flat at zero regret and constant norm --- the $2{\times }2$ ablation attributes the cure to error feedback, not the soft-bound. Fully multiply-free. Data: \texttt  {v4\_tele\_precut\_*}.}}{13}{figure.caption.14}\protected@file@percent }
\newlabel{fig:efabl}{{1}{13}{\textbf {Error feedback cures the sign-SGD collapse.} On a held-LR, every-window-kicks, stationary, anchorless adversary, naked \texttt {PureTropicalSGD} and a soft-bound-only variant diverge (regret climbs, weight norm runs away) while the error-feedback arms stay flat at zero regret and constant norm --- the $2{\times }2$ ablation attributes the cure to error feedback, not the soft-bound. Fully multiply-free. Data: \texttt {v4\_tele\_precut\_*}}{figure.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {The pre-registered validation ladder.} Every gate's pass/kill criteria were fixed before its run.}}{13}{table.caption.11}\protected@file@percent }
\newlabel{tab:ladder}{{1}{13}{Extended Data}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Multiply-free optimizers vs.\ AdamW} on the gated drift life (headroom captured; single seed) and under a consecutive-update adversary. No closed arm reaches AdamW's plasticity, and no single closed arm is both maximally plastic and adversary-immune; \texttt  {PureTropicalSGD} is the closed default (gate provides stability), error feedback is adversary insurance. Data: \texttt  {v4\_life}, \texttt  {v4\_tele\_precut\_*}.}}{14}{table.caption.13}\protected@file@percent }
\newlabel{tab:opt}{{2}{14}{Extended Data}{table.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Why the tropical substrate makes learning free of a second computation.} Serving runs the forward pass of a max-plus (tropical) network: in each layer a single winning path is selected and its winners are cached (left, blue). Learning is the \emph  {same} cached path traversed backward (right, purple): assigning credit is a gather/scatter/add along routes the forward pass already committed---no multiplication, no second network, and no stored activation graph. This is the visual statement of the mechanism in Fig.~\ref {fig:loop} and the exactness measured in Fig.~\ref {fig:depth}a. Conceptual illustration.}}{15}{figure.caption.16}\protected@file@percent }
\newlabel{supp:pc}{{1}{15}{\textbf {Why the tropical substrate makes learning free of a second computation.} Serving runs the forward pass of a max-plus (tropical) network: in each layer a single winning path is selected and its winners are cached (left, blue). Learning is the \emph {same} cached path traversed backward (right, purple): assigning credit is a gather/scatter/add along routes the forward pass already committed---no multiplication, no second network, and no stored activation graph. This is the visual statement of the mechanism in Fig.~\ref {fig:loop} and the exactness measured in Fig.~\ref {fig:depth}a. Conceptual illustration}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {A persistent living system versus the conventional split.} Left: our loop is one always-on process sitting on its stream of experience, serving every input and---when surprised---learning in place, at energy so low it is below the measurement floor; the experience \emph  {is} the training, and every update is auditable. Right: the deployed norm keeps a model current with a separate, power-hungry training cluster that periodically ships a frozen snapshot to a distinct serving system, coupled by synchronization and replay storage. The paper's contribution is collapsing the right-hand picture into the left one for supervised prediction (main text, ``From perception to agency''; Box~1). Conceptual illustration.}}{16}{figure.caption.17}\protected@file@percent }
\newlabel{supp:org}{{2}{16}{\textbf {A persistent living system versus the conventional split.} Left: our loop is one always-on process sitting on its stream of experience, serving every input and---when surprised---learning in place, at energy so low it is below the measurement floor; the experience \emph {is} the training, and every update is auditable. Right: the deployed norm keeps a model current with a separate, power-hungry training cluster that periodically ships a frozen snapshot to a distinct serving system, coupled by synchronization and replay storage. The paper's contribution is collapsing the right-hand picture into the left one for supervised prediction (main text, ``From perception to agency''; Box~1). Conceptual illustration}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Why predictive coding stays stable at depth on this substrate.} Naively settling the states of a deep predictive-coding network amplifies error with depth: the dynamics diverge and accuracy collapses to chance (left). Our substrate instead relaxes the \emph  {errors} with routing frozen, which is triangular and therefore unconditionally stable, and collapses to a single multiply-free reverse sweep that stays accurate to 128 layers (right). This is the conceptual companion to the measured curves in Fig.~\ref {fig:depth}b. Conceptual illustration.}}{17}{figure.caption.18}\protected@file@percent }
\newlabel{supp:depth}{{3}{17}{\textbf {Why predictive coding stays stable at depth on this substrate.} Naively settling the states of a deep predictive-coding network amplifies error with depth: the dynamics diverge and accuracy collapses to chance (left). Our substrate instead relaxes the \emph {errors} with routing frozen, which is triangular and therefore unconditionally stable, and collapses to a single multiply-free reverse sweep that stays accurate to 128 layers (right). This is the conceptual companion to the measured curves in Fig.~\ref {fig:depth}b. Conceptual illustration}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {A predictive-coding, neuromimetic device living a lifelong stream.} A stylized cortical hierarchy predicts its input and propagates prediction error; over a lifetime of experience, surprise gates plasticity (a neuromodulatory ``learn-now'' signal), consolidation is set by the precision of predictions rather than by the magnitude of change, and fast wake plasticity is complemented by slow consolidation. The cortical correspondences (no weight transport, $\sim $20~W energy, priors resolving ambiguity) are a source of hypotheses; every claim in the paper is settled by measurement, not by the analogy. \emph  {(Design draft; to be redrawn as a vector figure for submission.)}}}{18}{figure.caption.19}\protected@file@percent }
\newlabel{supp:neuro}{{4}{18}{\textbf {A predictive-coding, neuromimetic device living a lifelong stream.} A stylized cortical hierarchy predicts its input and propagates prediction error; over a lifetime of experience, surprise gates plasticity (a neuromodulatory ``learn-now'' signal), consolidation is set by the precision of predictions rather than by the magnitude of change, and fast wake plasticity is complemented by slow consolidation. The cortical correspondences (no weight transport, $\sim $20~W energy, priors resolving ambiguity) are a source of hypotheses; every claim in the paper is settled by measurement, not by the analogy. \emph {(Design draft; to be redrawn as a vector figure for submission.)}}{figure.caption.19}{}}
