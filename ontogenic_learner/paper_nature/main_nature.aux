\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {One process that perceives and learns, and the study.} Top: the paradigm---a single predictive-coding device sits on its stream of experience; serving is inference, and whenever it is surprised the same computation becomes an (occasional, multiply-free) learning step. Bottom: a roadmap of the study---the mechanism, its exactness and depth, that it pays, a device-scale lifetime, silicon energy, and a fully closed optimizer---each validated in the results. \emph  {(Design draft; to be redrawn as a vector figure for submission.)}}}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:paradigm}{{1}{2}{\textbf {One process that perceives and learns, and the study.} Top: the paradigm---a single predictive-coding device sits on its stream of experience; serving is inference, and whenever it is surprised the same computation becomes an (occasional, multiply-free) learning step. Bottom: a roadmap of the study---the mechanism, its exactness and depth, that it pays, a device-scale lifetime, silicon energy, and a fully closed optimizer---each validated in the results. \emph {(Design draft; to be redrawn as a vector figure for submission.)}}{figure.caption.2}{}}
