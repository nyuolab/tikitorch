\citation{espeholt2018impala,horgan2018distributed}
\citation{elsayed2024streaming}
\citation{sutton1991dyna}
\newlabel{fig:life}{{4}{5}{One process, 10M tokens, five rotated domain cycles. Top: prequential CE of the live learner vs.\ its frozen twin. Bottom: gate fire rate; kicks collapse $1{,}275\to 45$ per cycle; two late eras are fully silent and 42 of cycle 5's 45 kicks land in one storm at the final code revisit---the device learned its world, then mostly just served}{figure.4}{}}
\newlabel{fig:retention}{{5}{5}{Goal B. Top: held-out probe CE per domain at every era boundary; after the first cycle the trade is stable and improves with revisits (bounded, non-increasing interference). Bottom: weight norm reaches equilibrium ($+2.3\%$ over the life; slope decelerates $12\times $)}{figure.5}{}}
