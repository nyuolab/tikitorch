# synth_cl_forge_muzero.tcl — CL synth driver for the dyadic MuZero chess AFI. Mirrors the F2
# CL_TEMPLATE/synth_CL_TEMPLATE.tcl flow (aws-fpga rc/2.3.2): the HDK header (from $HDK_SHELL_DIR, NOT a
# local copy) sets CL_DIR / src_post_enc_dir / DEVICE_TYPE; encrypt.tcl has already staged design/*.{v,sv,vh,
# inc} AND the shell interface .inc files into $src_post_enc_dir (so cl_forge_muzero.sv's `include cl_ports.vh`
# + unused_*_template.inc resolve there). The footer runs synth_design (-mode out_of_context, top ${CL},
# part ${DEVICE_TYPE}). We add read_ip + synth_ip for our two IP (the OOC flow does NOT auto-synthesize IP).
# Invoked by aws_build_dcp_from_cl.py as synth_${CL}.tcl.
source ${HDK_SHELL_DIR}/build/scripts/synth_cl_header.tcl

# CL top + kernel RTL (+ shell .inc), all staged into the post-encryption source dir by encrypt.tcl
read_verilog -sv [glob ${src_post_enc_dir}/*.{s,}v]

# our IP (generated by gen_ip.tcl into $CL_DIR/design/ip): OCL AXI4-Lite slice + kernel->PCIM AXI4 slice
read_ip [glob $CL_DIR/design/ip/axi_register_slice_light/axi_register_slice_light.xci]
read_ip [glob $CL_DIR/design/ip/axi_register_slice_pcim/axi_register_slice_pcim.xci]
synth_ip [get_ips axi_register_slice_light]
synth_ip [get_ips axi_register_slice_pcim]

# Synthesize the CL (verbatim flags from synth_CL_TEMPLATE.tcl). MUST be here, not the footer —
# the footer's first command is write_checkpoint, which needs an already-synthesized open design.
# (The prior run proved read_verilog elaborated cl_forge_muzero + the PCIM wiring with 0 errors.)
synth_design -mode out_of_context \
             -top ${CL} \
             -verilog_define XSDB_SLV_DIS \
             -part ${DEVICE_TYPE} \
             -keep_equivalent_registers

source ${HDK_SHELL_DIR}/build/scripts/synth_cl_footer.tcl
