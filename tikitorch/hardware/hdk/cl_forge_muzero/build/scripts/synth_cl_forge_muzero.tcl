# synth_cl_forge_muzero.tcl — CL synth driver for the dyadic MuZero chess AFI (adapts
# synth_cl_forge_morph_lm.tcl). Non-project OOC flow: read the flat (encryption-flattened) CL + kernel
# verilog, then read_ip + synth_ip the IP (the OOC flow does NOT auto-synthesize IP -> synth_ip required,
# else 'module axi_register_slice_* not found'), then synth the CL out_of_context.
# Invoked by aws_build_dcp_from_cl.py via the standard HDK build (this file mirrors the morph-LM driver).
source [file join [file dirname [info script]] synth_cl_header.tcl] -notrace

# kernel RTL (HLS export) + the CL top, flattened into $CL_DIR/design by the build scaffold
read_verilog -sv [glob $CL_DIR/design/*.sv]
read_verilog    [glob $CL_DIR/design/*.v]

# IP: OCL AXI4-Lite slice + the kernel->PCIM AXI4 slice (generated by gen_ip.tcl)
foreach ip {axi_register_slice_light axi_register_slice_pcim} {
    read_ip [glob $CL_DIR/build/ip/$ip/$ip.xci]
    synth_ip [get_ips $ip]
}

synth_design -mode out_of_context -keep_equivalent_registers \
    -top cl_forge_muzero -part [get_property PART [current_project]] \
    -include_dirs $CL_DIR/design
